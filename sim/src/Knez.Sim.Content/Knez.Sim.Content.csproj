<Project Sdk="Microsoft.NET.Sdk">

  <!-- Content loading: JSON text → immutable defs (ADR-0004). Same constraints as Knez.Sim (netstandard2.1, C# 9,
       no Unity, no floating point, no I/O — callers pass text); the folder is also a Unity local package. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Knez.Sim.Content</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Knez.Sim\Knez.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Knez.Sim.Tests" />
  </ItemGroup>

</Project>
