{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet run *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet format *)",
      "Bash(dotnet --info)",
      "Bash(dotnet --list-sdks)",
      "Bash(python3 tools/check_sim_purity.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git lfs ls-files *)",
      "Bash(git lfs status *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_ENV_FILE\" ] && [ -x \"$CLAUDE_PROJECT_DIR/.venv/bin/python\" ]; then printf 'export VIRTUAL_ENV=\"%s/.venv\"\\nexport PATH=\"%s/.venv/bin:$PATH\"\\n' \"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR\" >> \"$CLAUDE_ENV_FILE\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$py\" ] || py=python3; \"$py\" \"$CLAUDE_PROJECT_DIR/tools/check_sim_purity.py\" --hook",
            "timeout": 20,
            "statusMessage": "Sim purity check"
          }
        ]
      }
    ]
  }
}
