<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-level NuGet settings: restore only from nuget.org, whatever other feeds are configured on the machine.
     Packages go to the normal shared cache (~/.nuget/packages); it is safe to share — each version is stored once
     and never modified. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
